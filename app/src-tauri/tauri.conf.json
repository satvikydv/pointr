{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pointr",
  "version": "0.1.1",
  "identifier": "dev.pointr.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Pointr",
        "label": "splash",
        "url": "splash.html",
        "width": 300,
        "height": 180,
        "resizable": false,
        "visible": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "transparent": true,
        "decorations": false
      },
      {
        "title": "Pointr Overlay",
        "label": "main",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "title": "Pointr Settings",
        "label": "settings",
        "url": "settings.html",
        "width": 420,
        "height": 640,
        "resizable": false,
        "visible": false,
        "center": true,
        "skipTaskbar": false,
        "transparent": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
